# ============================================
# 鉴真数据系统 - Docker Compose 环境变量示例
# ============================================
# 使用方法：
# 1. 复制本文件为 .env
#    Windows PowerShell:
#    Copy-Item .env.example .env
#
#    Git Bash / Linux / macOS:
#    cp .env.example .env
#
# 2. 修改 .env 中的密钥和密码
# 3. .env 不要提交到 Git
# ============================================

# MySQL root 密码
# 注意：
# 如果 mysql/data 已经初始化过，直接修改这里不会自动修改数据库里的 root 密码。
# 本地已有数据时，建议先保持原密码，或者手动进 MySQL 修改密码。
MYSQL_ROOT_PASSWORD=VeriData@2024

# 后端连接数据库使用的密码
# 通常应与 MYSQL_ROOT_PASSWORD 保持一致，除非你单独创建了业务数据库用户。
DB_PASSWORD=VeriData@2024

# JWT 登录令牌签名密钥
# 正式部署必须改成随机字符串。
# 生成方式：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_HEX_STRING

# 后端调用 AI 服务的内部令牌
# 正式部署必须改成随机字符串。
# 后端和 AI 服务必须使用同一个值。
# 生成方式：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_INTERNAL_TOKEN=CHANGE_THIS_TO_64_CHAR_RANDOM_HEX_STRING

# AI API Key 加密密钥
# 如果你在系统管理里配置外部大模型 API Key，生产环境必须固定设置。
# 一旦已有加密数据，不要随便更换，否则旧 API Key 可能无法解密。
SETTINGS_ENCRYPTION_KEY=CHANGE_THIS_TO_64_CHAR_RANDOM_HEX_STRING

# 登录会话配置
SESSION_SINGLE_LOGIN_ENABLED=true
SESSION_TTL_SECONDS=604800

# 镜像源配置，可不改
MYSQL_IMAGE=mysql:8.0
BACKEND_NODE_IMAGE=node:18-alpine
FRONTEND_NODE_IMAGE=node:18-alpine
FRONTEND_NGINX_IMAGE=nginx:alpine
AI_PYTHON_IMAGE=python:3.9-slim
