# ============================================
# 鉴真数据系统 - 环境变量配置示例
# ============================================
# 警告: 请勿在生产环境使用此示例值！
# 必须修改为强密码和随机密钥！
# ============================================

# 数据库配置（生产环境必须修改密码）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_MIN_12_CHARS
DB_NAME=veri_data
# 时区配置
# 中国大陆/新加坡演示环境建议保持 +08:00
TZ=Asia/Shanghai
DB_TIMEZONE=+08:00

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT配置（必须32字符以上随机字符串）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_32_CHAR_RANDOM_STRING_MINIMUM_LENGTH_REQUIRED
JWT_EXPIRES_IN=7d

# 登录会话配置
# true：同一账号只允许最后一次登录有效；false：允许多端同时登录
SESSION_SINGLE_LOGIN_ENABLED=true
# 服务端会话有效期，建议与 JWT_EXPIRES_IN 保持一致
SESSION_TTL_SECONDS=604800

# 系统敏感配置加密密钥
# 用于加密数据库中的 AI API Key。生产环境必须固定保存，不能频繁更换。
# 生成方式:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=CHANGE_THIS_TO_64_CHAR_RANDOM_HEX_STRING

# 服务配置
PORT=3000
NODE_ENV=development
API_VERSION=v1

# AI服务配置
AI_SERVICE_URL=http://localhost:5000

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=104857600

# CORS配置（生产环境必须设置具体域名）
# CORS_ORIGIN=https://your-domain.com

# 邮件验证码配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-authorization-code